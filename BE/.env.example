# URL kết nối Cơ sở dữ liệu SQLite.
# Bắt buộc phải giữ định dạng "file:./tên_file.db"
DATABASE_URL="file:./dev.db"

# Các chuỗi bí mật dùng để mã hoá token (JWT)
# (Trong thực tế hãy thay bằng một chuỗi ngẫu nhiên dài, không chia sẻ cho ai)
JWT_SECRET="your_jwt_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"

# Cổng chạy backend server
PORT="3000"
